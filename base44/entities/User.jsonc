{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "tc",
        "investor",
        "pml",
        "pending"
      ],
      "default": "pending"
    },
    "member_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "phone": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "expertise_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "member_type": {
      "type": "string"
    },
    "selected_plan": {
      "type": "string"
    },
    "onboarding_step": {
      "type": "string"
    },
    "nda_accepted": {
      "type": "boolean"
    },
    "nda_accepted_date": {
      "type": "string"
    },
    "nda_signer_name": {
      "type": "string"
    },
    "non_compete_accepted": {
      "type": "boolean"
    },
    "non_compete_accepted_date": {
      "type": "string"
    },
    "non_compete_signer_name": {
      "type": "string"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "stripe_price_id": {
      "type": "string"
    },
    "stripe_next_billing": {
      "type": "string"
    },
    "stripe_status": {
      "type": "string"
    }
  },
  "required": [
    "phone",
    "company_name",
    "website",
    "state",
    "expertise_areas",
    "member_type",
    "selected_plan",
    "onboarding_step",
    "nda_accepted",
    "nda_accepted_date",
    "nda_signer_name",
    "non_compete_accepted",
    "non_compete_accepted_date",
    "non_compete_signer_name",
    "stripe_customer_id",
    "stripe_subscription_id",
    "stripe_price_id",
    "stripe_next_billing",
    "stripe_status"
  ]
}